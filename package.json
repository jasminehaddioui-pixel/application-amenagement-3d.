{
  "name": "plan-superette",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Logiciel professionnel d'amenagement de locaux commerciaux (superette) : plan 2D, vue 3D, bibliotheque d'objets, exports.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "preview": "vite preview",
    "verifier:implantation": "esbuild scripts/verifier-implantation.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verifier-implantation.mjs && node node_modules/.cache/verifier-implantation.mjs",
    "verifier:hagetmau": "esbuild scripts/verifier-hagetmau.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/verifier-hagetmau.mjs && node node_modules/.cache/verifier-hagetmau.mjs"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
